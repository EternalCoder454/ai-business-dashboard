# ---------------------------------------------------------------------------
# Anthropic
# ---------------------------------------------------------------------------
# When this is set the server uses it and IGNORES the key field in Settings, so
# a deployed instance always spends against one key held on the server. Leave it
# unset locally if you would rather use the Settings field.
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Auth (optional locally, required for any deployment)
# ---------------------------------------------------------------------------
# Auth switches itself on only when all three AUTH_ values are present. Without
# them the app runs wide open, which is what you want on your own machine and
# never what you want on a public URL.
#
# 1. Generate the secret:      npx auth secret
# 2. Create an OAuth client:   https://console.cloud.google.com/apis/credentials
#    Application type:         Web application
#    Authorised redirect URI:  http://localhost:3000/api/auth/callback/google
#                              https://YOUR-DOMAIN/api/auth/callback/google
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma separated. Anyone not on this list is refused after Google authenticates
# them, so the workspace stays private even on a public address.
ALLOWED_EMAILS=eternalhell@eterneon.net
